# Names only. Never a value in this file — it is the one `.env*` that is
# tracked, which is exactly why it must stay empty of secrets.
#
# Copy to `.env.local` (gitignored) and fill in locally. `.env.local` is for
# DEVELOPMENT ONLY. From UAT onward every credential below moves into
# `config.integration_credential` + the secret backend, is read server-side
# through `config.get_integration_credential`, and every read is audited.
# See CLAUDE.md §4 and docs/adr/0001-data-residency-and-datastore.md.
#
# NEVER prefix any of these with NEXT_PUBLIC_. That prefix inlines the value
# into the JavaScript bundle served to every browser. There is a test
# asserting it does not happen.

# -- Cache -------------------------------------------------------------------
# Development only. The hosted endpoint is outside the Kingdom, so it is not
# lawful for UAT or above under NFR-05 / RC-03 / AP-09 — see ADR 0001 and
# ClaudeRecommendations.md R-14.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# -- Database ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -- Integrations ------------------------------------------------------------
# Present here only so a developer can see what the adapters expect. In every
# deployed environment these are resolved from the credential store, not the
# process environment.
#
# Adapters read credentials through the EnvironmentCredentialProvider
# (adapters/kernel/credentials-environment.ts), which derives the variable from
# the credential reference:  SANAD_CREDENTIAL_<PROVIDER>_<ENVIRONMENT>_<KEY_NAME>
# The PROVIDER is the port's capability name, not the vendor's.
TUUM_BASE_URL=
TUUM_CLIENT_ID=
TUUM_CLIENT_SECRET=

# Document platform — Nutrient (adapters/nutrient/verification/README.md)
# The Web SDK licence key is bound to a domain and is served to the browser by
# the viewer page; it is not a secret in the vault sense but is still never
# committed. The Document Engine token and the JWT private key are secrets.
SANAD_CREDENTIAL_DOCUMENT_PLATFORM_SANDBOX_WEB_SDK_LICENSE_KEY=
SANAD_CREDENTIAL_DOCUMENT_PLATFORM_SANDBOX_DOCUMENT_ENGINE_BASE_URL=
SANAD_CREDENTIAL_DOCUMENT_PLATFORM_SANDBOX_DOCUMENT_ENGINE_API_TOKEN=
SANAD_CREDENTIAL_DOCUMENT_PLATFORM_SANDBOX_JWT_PRIVATE_KEY=
