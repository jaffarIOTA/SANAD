{
  "name": "sanad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "products"
  ],
  "description": "Sanad — Shariah-compliant origination platform. Wasl — SME supply chain finance.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web-test.json && tsc --noEmit -p services/origination && tsc --noEmit -p services/outbox && tsc --noEmit -p apps/sme && tsc --noEmit -p apps/ops && tsc --noEmit -p apps/consumer && tsc --noEmit -p apps/admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compliance": "vitest run test/compliance",
    "verify": "npm run build:apic && npm run typecheck && npm run test",
    "dev": "next dev apps/sme",
    "build:sme": "next build apps/sme",
    "dev:ops": "next dev apps/ops --port 3001",
    "build:ops": "next build apps/ops",
    "dev:api": "node --experimental-strip-types services/origination/src/index.ts",
    "build:apic": "node scripts/build-apic-definition.mjs",
    "dev:consumer": "next dev apps/consumer --port 3003",
    "build:consumer": "next build apps/consumer",
    "dev:outbox": "node --experimental-strip-types services/outbox/src/index.ts",
    "nutrient:assets": "node scripts/nutrient-assets.mjs",
    "nutrient:samples": "node scripts/nutrient-samples.mjs",
    "dev:admin": "next dev apps/admin --port 3004",
    "db:connect": "bash scripts/set-database-url.sh",
    "db:push": "bash scripts/db-push.sh",
    "db:start": "npx --yes supabase start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@nutrient-sdk/viewer": "^1.22.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    },
    "@swc/core": {
      "@swc/helpers": "^0.5.17"
    }
  }
}
