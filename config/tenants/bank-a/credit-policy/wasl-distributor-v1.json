{
  "policyId": "wasl-distributor",
  "version": "1.0.0",
  "tenantId": "bank-a",
  "programmeScope": "ALL",
  "currency": "SAR",

  "effectiveFromEpochSeconds": "1790899200",

  "approval": {
    "creditApprovalRef": "CRC-A-2026-031",
    "approvedByRole": "CREDIT_RISK_COMMITTEE",
    "approvedOnEpochSeconds": "1790467200"
  },

  "notes": "Placeholder thresholds. Every figure below is owned by the institution's Credit function and is authored and approved outside the release cycle (BR-C08). Nothing here is a platform default.",

  "dataRequirements": {
    "requiredConsents": ["eInvoicing", "creditBureau"],
    "maximumSourceAgeSeconds": {
      "registration.retrievedSecondsAgo": 2592000,
      "screening.retrievedSecondsAgo": 2592000,
      "tradeHistory.retrievedSecondsAgo": 604800,
      "bureau.retrievedSecondsAgo": 7776000
    },
    "staleDataReasonCode": "R_STALE_DATA",
    "missingConsentReasonCode": "R_MISSING_CONSENT"
  },

  "knockouts": [
    {
      "code": "KO_REGISTRATION_NOT_ACTIVE",
      "when": { "op": "ne", "left": { "field": "registration.status" }, "right": { "const": "ACTIVE" } },
      "outcome": "DECLINE",
      "reasonCode": "R_REGISTRATION_NOT_ACTIVE"
    },
    {
      "code": "KO_SIGNATORY_UNVERIFIED",
      "when": {
        "op": "eq",
        "left": { "field": "signatory.authorityVerified" },
        "right": { "const": false }
      },
      "outcome": "REFER",
      "reasonCode": "R_SIGNATORY_UNVERIFIED"
    },
    {
      "code": "KO_SANCTIONS_HIT",
      "when": { "op": "in", "left": { "field": "screening.sanctions" }, "right": ["HIT"] },
      "outcome": "DECLINE",
      "reasonCode": "R_SANCTIONS_MATCH"
    },
    {
      "code": "KO_SANCTIONS_INCONCLUSIVE",
      "when": {
        "op": "in",
        "left": { "field": "screening.sanctions" },
        "right": ["POTENTIAL_MATCH", "UNAVAILABLE"]
      },
      "outcome": "REFER",
      "reasonCode": "R_SCREENING_UNAVAILABLE"
    },
    {
      "code": "KO_ACTIVITY_EXCLUDED",
      "when": {
        "op": "eq",
        "left": { "field": "screening.activityPermissibility" },
        "right": { "const": "EXCLUDED" }
      },
      "outcome": "DECLINE",
      "reasonCode": "R_ACTIVITY_EXCLUDED"
    },
    {
      "code": "KO_ACTIVITY_REVIEW",
      "when": {
        "op": "eq",
        "left": { "field": "screening.activityPermissibility" },
        "right": { "const": "REVIEW" }
      },
      "outcome": "REFER",
      "reasonCode": "R_ACTIVITY_REVIEW"
    },
    {
      "code": "KO_POLITICALLY_EXPOSED",
      "when": {
        "op": "in",
        "left": { "field": "screening.politicallyExposed" },
        "right": ["HIT", "POTENTIAL_MATCH"]
      },
      "outcome": "REFER",
      "reasonCode": "R_PEP_MATCH"
    },
    {
      "code": "KO_TRADE_HISTORY_UNAVAILABLE",
      "when": {
        "op": "ne",
        "left": { "field": "tradeHistory.availability" },
        "right": { "const": "AVAILABLE" }
      },
      "outcome": "REFER",
      "reasonCode": "R_TRADE_HISTORY_UNAVAILABLE"
    },
    {
      "code": "KO_REGISTRATION_TOO_RECENT",
      "when": { "op": "lt", "left": { "field": "registration.ageMonths" }, "right": { "const": 24 } },
      "outcome": "DECLINE",
      "reasonCode": "R_REGISTRATION_TOO_RECENT"
    },
    {
      "code": "KO_INSUFFICIENT_ANCHOR_TRADE",
      "when": {
        "op": "lt",
        "left": { "field": "tradeHistory.withAnchor.monthsTrading" },
        "right": { "const": 6 }
      },
      "outcome": "DECLINE",
      "reasonCode": "R_INSUFFICIENT_ANCHOR_TRADE"
    },
    {
      "code": "KO_RECENT_DEFAULT",
      "when": { "op": "gt", "left": { "field": "bureau.defaultsLast24Months" }, "right": { "const": 0 } },
      "outcome": "DECLINE",
      "reasonCode": "R_RECENT_DEFAULT"
    },
    {
      "code": "KO_JUDGMENT_RECORDED",
      "when": { "op": "gt", "left": { "field": "bureau.judgmentCount" }, "right": { "const": 0 } },
      "outcome": "REFER",
      "reasonCode": "R_JUDGMENT_RECORDED"
    }
  ],

  "scorecard": {
    "baseScore": 0,
    "characteristics": [
      {
        "code": "CH_ANCHOR_TENURE",
        "maxPoints": 25,
        "defaultPoints": 0,
        "defaultReasonCode": "R_LIMITED_ANCHOR_TENURE",
        "bands": [
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.monthsTrading" }, "right": { "const": 36 } }, "points": 25 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.monthsTrading" }, "right": { "const": 24 } }, "points": 20 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.monthsTrading" }, "right": { "const": 12 } }, "points": 14 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.monthsTrading" }, "right": { "const": 6 } }, "points": 8 }
        ]
      },
      {
        "code": "CH_ANCHOR_VOLUME",
        "maxPoints": 20,
        "defaultPoints": 0,
        "defaultReasonCode": "R_LIMITED_ANCHOR_VOLUME",
        "bands": [
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" }, "right": { "constMoneyMinorUnits": "50000000" } }, "points": 20 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" }, "right": { "constMoneyMinorUnits": "20000000" } }, "points": 15 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" }, "right": { "constMoneyMinorUnits": "8000000" } }, "points": 9 },
          { "when": { "op": "gte", "left": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" }, "right": { "constMoneyMinorUnits": "3000000" } }, "points": 4 }
        ]
      },
      {
        "code": "CH_PAYMENT_BEHAVIOUR",
        "maxPoints": 20,
        "defaultPoints": 0,
        "defaultReasonCode": "R_PAYMENT_BEHAVIOUR",
        "bands": [
          { "when": { "op": "lte", "left": { "field": "tradeHistory.withAnchor.latePaymentPerTenThousand" }, "right": { "const": 500 } }, "points": 20 },
          { "when": { "op": "lte", "left": { "field": "tradeHistory.withAnchor.latePaymentPerTenThousand" }, "right": { "const": 1500 } }, "points": 14 },
          { "when": { "op": "lte", "left": { "field": "tradeHistory.withAnchor.latePaymentPerTenThousand" }, "right": { "const": 3000 } }, "points": 7 }
        ]
      },
      {
        "code": "CH_DISPUTES",
        "maxPoints": 10,
        "defaultPoints": 0,
        "defaultReasonCode": "R_DISPUTES",
        "bands": [
          { "when": { "op": "eq", "left": { "field": "tradeHistory.withAnchor.disputeCount" }, "right": { "const": 0 } }, "points": 10 },
          { "when": { "op": "lte", "left": { "field": "tradeHistory.withAnchor.disputeCount" }, "right": { "const": 2 } }, "points": 6 }
        ]
      },
      {
        "code": "CH_BUREAU_CONDUCT",
        "maxPoints": 15,
        "defaultPoints": 0,
        "defaultReasonCode": "R_BUREAU_ARREARS",
        "bands": [
          { "when": { "op": "eq", "left": { "field": "bureau.worstArrearsDaysLast12Months" }, "right": { "const": 0 } }, "points": 15 },
          { "when": { "op": "lte", "left": { "field": "bureau.worstArrearsDaysLast12Months" }, "right": { "const": 30 } }, "points": 10 },
          { "when": { "op": "lte", "left": { "field": "bureau.worstArrearsDaysLast12Months" }, "right": { "const": 60 } }, "points": 4 }
        ]
      },
      {
        "code": "CH_BUSINESS_SUBSTANCE",
        "maxPoints": 10,
        "defaultPoints": 2,
        "defaultReasonCode": "R_LIMITED_SUBSTANCE",
        "bands": [
          { "when": { "op": "gte", "left": { "field": "workforce.employeeCount" }, "right": { "const": 10 } }, "points": 10 },
          { "when": { "op": "gte", "left": { "field": "workforce.employeeCount" }, "right": { "const": 3 } }, "points": 6 }
        ]
      },
      {
        "code": "CH_BUYER_CONCENTRATION",
        "maxPoints": 10,
        "defaultPoints": 2,
        "defaultReasonCode": "R_BUYER_CONCENTRATION",
        "bands": [
          { "when": { "op": "lte", "left": { "field": "tradeHistory.largestBuyerSharePerTenThousand" }, "right": { "const": 5000 } }, "points": 10 },
          { "when": { "op": "lte", "left": { "field": "tradeHistory.largestBuyerSharePerTenThousand" }, "right": { "const": 7500 } }, "points": 6 }
        ]
      }
    ]
  },

  "grades": [
    { "grade": "A", "minScore": 85, "outcome": "APPROVE" },
    { "grade": "B", "minScore": 70, "outcome": "APPROVE" },
    { "grade": "C", "minScore": 55, "outcome": "REFER", "reasonCode": "R_GRADE_REFER" },
    { "grade": "D", "minScore": 0, "outcome": "DECLINE", "reasonCode": "R_GRADE_DECLINE" }
  ],

  "limit": {
    "basisByGrade": {
      "A": {
        "op": "scaleBasisPoints",
        "arg": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" },
        "basisPoints": 30000
      },
      "B": {
        "op": "scaleBasisPoints",
        "arg": { "field": "tradeHistory.withAnchor.medianMonthlyValueMinorUnits" },
        "basisPoints": 20000
      }
    },
    "roundDownToMultipleOfMinorUnits": "100000",
    "minimumViableMinorUnits": "5000000",
    "caps": [
      { "code": "CAP_ABSOLUTE", "kind": "ABSOLUTE", "maxMoneyMinorUnits": "500000000" },
      {
        "code": "CAP_NO_OPEN_BANKING",
        "kind": "EXPRESSION",
        "when": { "op": "ne", "left": { "field": "openBanking.availability" }, "right": { "const": "AVAILABLE" } },
        "max": { "constMoneyMinorUnits": "100000000" }
      },
      {
        "code": "CAP_SINGLE_LARGEST_INVOICE",
        "kind": "EXPRESSION",
        "max": {
          "op": "scaleBasisPoints",
          "arg": { "field": "tradeHistory.withAnchor.largestSingleInvoiceMinorUnits" },
          "basisPoints": 40000
        }
      },
      { "code": "CAP_PROGRAMME_HEADROOM", "kind": "PROGRAMME_HEADROOM" },
      { "code": "CAP_CONCENTRATION_SHARE", "kind": "SHARE_OF_PROGRAMME_LIMIT", "shareBasisPoints": 1500 },
      { "code": "CAP_NET_OF_EXPOSURE", "kind": "NET_OF_EXISTING_EXPOSURE" }
    ]
  },

  "reasons": {
    "R_REGISTRATION_NOT_ACTIVE": {
      "ar": "السجل التجاري غير ساري المفعول.",
      "en": "The commercial registration is not currently valid."
    },
    "R_SIGNATORY_UNVERIFIED": {
      "ar": "لم يتم التحقق من صلاحية المفوّض بالتوقيع نيابة عن المنشأة.",
      "en": "The signatory's authority to act for the entity could not be verified."
    },
    "R_SANCTIONS_MATCH": {
      "ar": "تعذّر إتمام الطلب بناءً على نتيجة الفحص ضد القوائم الرقابية.",
      "en": "The request cannot proceed based on the outcome of regulatory list screening."
    },
    "R_SCREENING_UNAVAILABLE": {
      "ar": "نتيجة الفحص غير حاسمة أو الخدمة غير متاحة حالياً؛ سيُراجَع الطلب من قبل مختص.",
      "en": "The screening result is inconclusive or the service is unavailable; a specialist will review the application."
    },
    "R_ACTIVITY_EXCLUDED": {
      "ar": "نشاط المنشأة يقع ضمن الأنشطة غير المؤهلة وفق ضوابط الهيئة الشرعية.",
      "en": "The business activity falls within the activities excluded under the Shariah Board's criteria."
    },
    "R_ACTIVITY_REVIEW": {
      "ar": "يتطلب نشاط المنشأة مراجعة إضافية قبل اتخاذ القرار.",
      "en": "The business activity requires further review before a decision is made."
    },
    "R_PEP_MATCH": {
      "ar": "يتطلب الطلب مراجعة إضافية وفق متطلبات العناية الواجبة المشددة.",
      "en": "The application requires enhanced due diligence review."
    },
    "R_TRADE_HISTORY_UNAVAILABLE": {
      "ar": "تعذّر الحصول على سجل الفوترة الإلكترونية؛ سيُراجَع الطلب من قبل مختص.",
      "en": "The e-invoicing history could not be retrieved; a specialist will review the application."
    },
    "R_REGISTRATION_TOO_RECENT": {
      "ar": "عمر السجل التجاري أقل من الحد المطلوب لهذا البرنامج.",
      "en": "The commercial registration is younger than this programme requires."
    },
    "R_INSUFFICIENT_ANCHOR_TRADE": {
      "ar": "مدة التعامل التجاري مع المشتري الرئيسي أقل من الحد المطلوب.",
      "en": "The trading relationship with the anchor buyer is shorter than required."
    },
    "R_RECENT_DEFAULT": {
      "ar": "يوجد تعثّر سابق مسجّل خلال الأربعة والعشرين شهراً الماضية.",
      "en": "There is a recorded default within the last twenty-four months."
