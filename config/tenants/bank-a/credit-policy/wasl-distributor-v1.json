    "R_LIMITED_ANCHOR_VOLUME": {
      "ar": "حجم التعامل الشهري مع المشتري الرئيسي أقل من المستوى المطلوب للحد الكامل.",
      "en": "Monthly trading volume with the anchor buyer is below the level required for a full limit."
    },
    "R_PAYMENT_BEHAVIOUR": {
      "ar": "سجل السداد يتضمّن تأخيرات تتجاوز المستوى المفضّل.",
      "en": "The payment record includes delays beyond the preferred level."
    },
    "R_DISPUTES": {
      "ar": "وجود منازعات على فواتير سابقة أثّر على التقييم.",
      "en": "Disputes on previous invoices affected the assessment."
    },
    "R_BUREAU_ARREARS": {
      "ar": "سجل الائتمان يتضمّن متأخرات خلال الاثني عشر شهراً الماضية.",
      "en": "The credit record includes arrears within the last twelve months."
    },
    "R_LIMITED_SUBSTANCE": {
      "ar": "مؤشرات حجم المنشأة محدودة وفق بيانات التأمينات الاجتماعية.",
      "en": "Indicators of business scale are limited according to social insurance data."
    },
    "R_BUYER_CONCENTRATION": {
      "ar": "تركّز المبيعات لدى عدد محدود من المشترين أثّر على التقييم.",
      "en": "Concentration of sales among a small number of buyers affected the assessment."
    },
    "R_GRADE_REFER": {
      "ar": "لم يبلغ التقييم الحد المطلوب للموافقة الآلية؛ سيُراجَع الطلب من قبل مختص.",
      "en": "The assessment did not reach the threshold for automated approval; a specialist will review the application."
    },
    "R_GRADE_DECLINE": {
      "ar": "لم يبلغ التقييم الحد الأدنى المطلوب للموافقة على هذا البرنامج.",
      "en": "The assessment did not reach the minimum threshold for approval on this programme."
    },
    "R_STALE_DATA": {
      "ar": "البيانات المستخدمة في التقييم تجاوزت مدة الصلاحية؛ سيُعاد تحديثها ومراجعة الطلب.",
      "en": "The data used for the assessment is older than permitted; it will be refreshed and the application reviewed."
    },
    "R_MISSING_CONSENT": {
      "ar": "لم تُمنح الموافقة اللازمة للوصول إلى البيانات المطلوبة لتقييم الطلب.",
      "en": "The consent required to access the data needed to assess the application has not been given."
    }
  }
}
