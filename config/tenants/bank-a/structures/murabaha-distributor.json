{
  "definitionId": "MURABAHA_DISTRIBUTOR",
  "structureCode": "MURABAHA",
  "version": 3,
  "shariahApprovalRef": "SSB-A-2026-014",

  "legs": [
    { "type": "WAAD", "seq": 1, "document": "waad_promise" },
    { "type": "PURCHASE", "seq": 2, "document": "purchase_contract" },
    { "type": "SALE_OFFER", "seq": 3, "document": "murabaha_offer" },
    { "type": "ACCEPTANCE", "seq": 4, "document": "murabaha_acceptance" }
  ],

  "gates": [
    {
      "id": "GATE_1_OWNERSHIP",
      "kind": "EVIDENCE",
      "after": { "leg": "PURCHASE" },
      "requires": { "anyOf": ["OWNERSHIP_INVOICE", "TITLE_RECORD"] },
      "validation": {
        "recipientIsInstitution": true,
        "clearanceStatus": "CLEARED"
      },
      "requireThirdPartySource": true
    },
    {
      "id": "GATE_2_POSSESSION",
      "kind": "EVIDENCE",
      "after": { "gate": "GATE_1_OWNERSHIP" },
      "requires": {
        "anyOf": ["DELIVERY_NOTE", "WAREHOUSE_RECEIPT", "CONSTRUCTIVE_POSSESSION"]
      },
      "minimumExtractionConfidencePerTenThousand": 9000
    },
    {
      "id": "GATE_3_RISK_PERIOD",
      "kind": "ELAPSE",
      "after": { "gate": "GATE_2_POSSESSION" },
      "minimumSeconds": 3600,
      "clock": "TRUSTED_TIMESTAMP_AUTHORITY",
      "startBasis": "EARLIEST_DISCHARGING_EVIDENCE"
    }
  ],

  "constraints": {
    "distinctParties": [["PURCHASE.seller", "ACCEPTANCE.buyer"]],
    "oneDocumentPerLeg": true,
    "monotonicTimestamps": true
  }
}
