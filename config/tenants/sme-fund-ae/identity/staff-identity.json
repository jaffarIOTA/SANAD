{
  "version": "2026-10-09",
  "providers": {
    "DEVELOPMENT": {
      "protocol": "DEVELOPMENT",
      "issuer": "development:sme-fund-ae",
      "groupsClaim": "groups"
    },
    "DEPLOYED": {
      "protocol": "OIDC",
      "issuer": "https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0",
      "metadataUrl": "https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0/.well-known/openid-configuration",
      "clientId": "<ENTRA_CLIENT_ID>",
      "groupsClaim": "roles"
    }
  },
  "mappings": [
    {
      "group": "sanad.sme-fund-ae.makers",
      "authority": "MAKER"
    },
    {
      "group": "sanad.sme-fund-ae.checkers",
      "authority": "CHECKER"
    },
    {
      "group": "sanad.sme-fund-ae.senior-checkers",
      "authority": "SENIOR_CHECKER"
    },
    {
      "group": "sanad.sme-fund-ae.credit-committee",
      "authority": "CREDIT_COMMITTEE"
    },
    {
      "group": "sanad.sme-fund-ae.finance",
      "authority": "FINANCE"
    },
    {
      "group": "sanad.sme-fund-ae.platform-admins",
      "authority": "PLATFORM_ADMIN"
    }
  ],
  "sessionLifetimeSeconds": 1800,
  "stepUpForApprovalSeconds": 300
}
